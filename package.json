{
  "name": "dsh-stash",
  "version": "0.7.1",
  "private": true,
  "description": "外接数据源的门禁、钥匙与台账：把外部数据库/资料库/文献库登记成可检索的 Model Tool，声明每条库允许怎么取数，每次取数留一条只含指纹的台账（凭据值由宿主的 credentials 服务保管）。",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./client/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "client",
    "cordis.patch.yml",
    "README.md",
    "LICENSE",
    "sources.example.mjs"
  ],
  "license": "MIT",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": []
    }
  },
  "engines": {
    "node": ">=22"
  }
}

{
  "name": "dsh-stash",
  "version": "0.8.0",
  "description": "外接数据源的门禁、钥匙与台账：把外部数据库/资料库/文献库登记成可检索的 Model Tool，声明每条库允许怎么取数，每次取数留一条只含指纹的台账（凭据值由宿主的 credentials 服务保管）。",
  "keywords": [
    "dsh",
    "deepseek-harness",
    "cordis",
    "cordis-plugin",
    "plugin",
    "credentials",
    "secret-management",
    "mcp",
    "data-source",
    "provenance",
    "ledger",
    "model-tool"
  ],
  "homepage": "https://github.com/danieldu168/dsh-stash#readme",
  "bugs": {
    "url": "https://github.com/danieldu168/dsh-stash/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/danieldu168/dsh-stash.git"
  },
  "license": "MIT",
  "author": "danieldu168",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./client/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "client",
    "cordis.patch.yml",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "sources.example.mjs"
  ],
  "engines": {
    "node": ">=22"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": []
    }
  }
}
